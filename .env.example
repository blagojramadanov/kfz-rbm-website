# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only secret key (sb_secret_...). lib/supabase-admin.ts reads ONLY this name;
# SUPABASE_SERVICE_ROLE_KEY is not used by the code.
SUPABASE_SECRET_KEY=your-secret-key

# Admin Configuration
# This email will automatically receive the ADMIN role on first login
# Keep this in .env.local only (never commit to version control)
ADMIN_EMAIL=admin@example.com

# Localization
NEXT_PUBLIC_DEFAULT_LOCALE=de

# Public site URL for canonical links, hreflang, Open Graph and the sitemap (optional).
# Without it, the Vercel production domain is used (lib/seo.ts).
# NEXT_PUBLIC_SITE_URL=https://www.example.de
